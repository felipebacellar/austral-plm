# Supabase — preencha com os dados do seu projeto
# Encontre em: https://supabase.com/dashboard/project/SEU_PROJETO/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Chave administrativa (service role) — necessária para as rotas de gestão de
# usuários em app/api/users/*. NUNCA prefixar com NEXT_PUBLIC_ nem usar no
# client: essa chave ignora RLS e dá acesso total ao banco.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# API de dados do Linx (servidor do BI). Usada só server-side em lib/linx.ts.
# NUNCA prefixar com NEXT_PUBLIC_ — a chave não pode chegar ao navegador.
LINX_API_BASE_URL=https://bi.austral.com.br/api/linx
LINX_API_KEY=sua_linx_api_key_aqui
